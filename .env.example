# Copy to .env and replace the example secrets before running the JAR.
ADMIN_EMAIL=you@example.com
APP_PORT=18080
APP_DATABASE_URL=jdbc:sqlite:./data/jobtracker.db
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Optional
ALLOW_REGISTRATION=true
REGISTRATION_CODE=
SESSION_DAYS=7
AI_CALLS_ENABLED=true
AI_ALLOWED_HOSTS=api.openai.com,api.deepseek.com
