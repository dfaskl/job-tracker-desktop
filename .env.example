# Only ADMIN_EMAIL needs to be chosen manually. The setup scripts generate the secrets.
ADMIN_EMAIL=you@example.com
APP_PORT=8080
POSTGRES_PASSWORD=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Optional
ALLOW_REGISTRATION=true
REGISTRATION_CODE=
SESSION_DAYS=7
AI_CALLS_ENABLED=true
AI_ALLOWED_HOSTS=api.openai.com,api.deepseek.com