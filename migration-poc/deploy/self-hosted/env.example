# 应用监听端口。服务器当前推荐使用 18080。
APP_PORT=18080

# 新部署默认使用同目录 data/jobtracker.db；迁移脚本会写入绝对路径。
APP_DATABASE_URL='jdbc:sqlite:./data/jobtracker.db'

# 迁移现有数据时必须沿用线上值，否则已有会话或加密数据可能失效。
SESSION_SECRET='替换为原来的SESSION_SECRET，至少32个字符'
ENCRYPTION_KEY='替换为原来的ENCRYPTION_KEY，至少32个字符'
ADMIN_EMAIL='替换为管理员邮箱'

ALLOW_REGISTRATION=true
REGISTRATION_CODE=''
SESSION_DAYS=7
AI_CALLS_ENABLED=true
AI_ALLOWED_HOSTS='api.openai.com,api.deepseek.com'

# Java 内存限制。这台服务器资源充足，默认值已够当前项目使用。
JAVA_XMS=256m
JAVA_XMX=1024m

# SQLite 每天 03:30 自动生成一致性备份，默认保留 14 份。
SQLITE_BACKUP_ENABLED=true
SQLITE_BACKUP_RETENTION=14
