# PostgreSQL connection URL. For the free deployment, copy the Neon pooled connection string.
DATABASE_URL=provided-by-your-postgresql-service

# At least 32 random characters. Never commit the real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-at-least-32-random-characters

NODE_ENV=production
PORT=3000
SESSION_DAYS=7

# Existing login email that should receive administrator privileges on startup.
ADMIN_EMAIL=owner@example.com

# Registration controls for a small private user group.
ALLOW_REGISTRATION=true
REGISTRATION_CODE=replace-with-a-private-invite-code

# Optional comma-separated allowlist. Leave empty to allow public HTTPS API hosts.
AI_ALLOWED_HOSTS=api.deepseek.com,api.openai.com

# Only for a trusted LAN development endpoint; never enable in production.
ALLOW_INSECURE_AI_URL=false
